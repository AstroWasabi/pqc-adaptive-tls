# pqc-adaptive-tls .gitignore

# Object files & archives
*.o
*.a
*.so
*.dylib

# Binaries
c_dispatch/server
c_dispatch/bench_e2e
c_dispatch/benchmark_suite
c_dispatch/bench_prims
c_dispatch/tests/test_*

# Logs and runtime JSON artifacts
*.log
c_dispatch/*.log
c_dispatch/host_profile.json
c_dispatch/benchmark_results.json
c_dispatch/e2e_benchmark_results.json

# Tooling & IDE
.DS_Store
.vscode/
.idea/
compile_commands.json
.clangd/

# Python cache & virtualenvs
__pycache__/
*.py[cod]
venv/
.venv/
env/
